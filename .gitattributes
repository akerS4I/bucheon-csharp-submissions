# Auto detect text files and normalize line endings
* text=auto

# C# source files
*.cs text eol=crlf

# Project files
*.csproj text eol=crlf
*.sln text eol=crlf
*.config text eol=crlf

# Documentation
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
